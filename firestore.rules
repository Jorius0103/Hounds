rules_version = '2';

// Só quem entrou com a conta da campanha lê e grava.
// Troque o e-mail abaixo pelo mesmo de campaignEmail em firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'EMAIL-DA-CAMPANHA';
    }
  }
}
